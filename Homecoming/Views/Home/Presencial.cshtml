

<div class="container mt-5">
    <h1 class="text-center mb-4">Inscripción presencial</h1>
    <p class="text-center">Selecciona tu jornada:</p>

    <div class="row justify-content-center g-4">

        <div class="col-md-4">
            <div class="card shadow p-4 text-center">
                <h2>Matutino</h2>
                <a asp-controller="Home"
                   asp-action="Inscripcion"
                   asp-route-jornada="Matutino"
                   class="btn btn-primary">
                    Seleccionar
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 text-center">
                <h2>Nocturno</h2>
                <a asp-controller="Home"
                   asp-action="Inscripcion"
                   asp-route-jornada="Nocturno"
                   class="btn btn-primary">
                    Seleccionar
                </a>
            </div>
        </div>

    </div>
</div>
